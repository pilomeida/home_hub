[Unit]
Description=Home Hub - check every 5 minutes which long scheduled jobs are due (their own lane, PLAN step 9 D5)

[Timer]
# On the clock (:00, :05, :10 ...) so a job planned for 07:30 starts at 07:30, not at some drifting moment.
OnCalendar=*:0/5
AccuracySec=10s
OnBootSec=3min
Persistent=true

[Install]
WantedBy=timers.target
